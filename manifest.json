{
  "manifest_version": 3,
  "name": "PreShot",
  "version": "0.1.0",
  "description": "Détecte les sites suspects au moment du paiement",

  "permissions": ["activeTab", "storage", "sidePanel"],

  "icons": {
    "128": "icons/icon_green.png"
  },

  "background": {
    "service_worker": "background/service_worker.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/detector.js", "content/banner.js"],
      "run_at": "document_idle"
    }
  ],

  "side_panel": {
    "default_path": "panel/panel.html"
  },

  "action": {
    "default_icon": {
      "128": "icons/icon_green.png"
    },
    "default_popup": "popup/popup.html"
  }
}
